> simulation_constants <- list(
+   n_area = 10L,
+   n_season = 6L,
+   n_week = 52L,
+   intervention_season = 5L,
+   alpha = -6.35,
+   sigma_area = 0.25,
+   sigma_season = 0.15,
+   beta_lag = 0.10,
+   beta_ses = 0.15,
+   beta_intensity = log(0.55),
+   beta_intensity_time = 0,
+   phi = 12,
+   fourier = c(0.75, -0.15, 0.30, -0.10),
+   # Area-season disturbance. Present in the model equation in the manuscript
+   # but absent from the v1 generator, so the v1 fitted model was never tested
+   # against clustering at the level at which the exposure varies.
+   sigma_area_season = 0.15
+ )
> 
> bounded_center <- function(x, lower, upper) {
+   x <- x - mean(x)
+   pmin(pmax(x, lower), upper)
+ }
> 
> simulate_one <- function(seed, sc) {
+   set.seed(seed)
+ 
+   K <- simulation_constants
+   A <- K$n_area
+   S <- K$n_season
+   W <- K$n_week
+ 
+   population_area <- pmax(
+     300L,
+     round(exp(rnorm(A, log(950), 0.22)))
+   )
+   ses_area <- as.numeric(scale(rnorm(A)))
+   latent_access <- rnorm(A)
+ 
+   area_re <- rnorm(A, 0, K$sigma_area)
+   season_re <- rnorm(S, 0, K$sigma_season)
+   # xi_rs: one draw per area-season, constant across the 52 weeks of a block,
+   # i.e. at exactly the level at which immunisation intensity varies.
+   area_season_re <- matrix(
+     rnorm(A * S, 0, K$sigma_area_season),
+     nrow = A, ncol = S
+   )
+ 
+   shift <- if (sc$shift_sd > 0) {
+     bounded_center(rnorm(S, 0, sc$shift_sd), -6, 6)
+   } else {
+     rep(0, S)
+   }
+ 
+   log_speed <- if (sc$speed_sd > 0) {
+     bounded_center(rnorm(S, 0, sc$speed_sd), -0.25, 0.25)
+   } else {
+     rep(0, S)
+   }
+ 
+   intensity_area_raw <- exp(
+     0.20 * ses_area +
+       sc$confounding * latent_access +
+       rnorm(A, 0, 0.18)
+   )
+   # Scale by the treated-area median so that intensity = 1 represents a
+   # typical programme intensity and intensity = 0 represents no programme.
+   intensity_area <- intensity_area_raw / median(intensity_area_raw)
+ 
+   out <- vector("list", A * S)
+   pos <- 1L
+ 
+   for (a in seq_len(A)) {
+     for (s in seq_len(S)) {
+       previous_y <- 0
+       treated_s <- as.integer(s >= K$intervention_season)
+       intensity_s <- if (treated_s == 1L) intensity_area[a] else 0
+ 
+       rows <- vector("list", W)
+ 
+       for (w in seq_len(W)) {
+         tau <- (w - shift[s]) * exp(log_speed[s])
+ 
+         epidemic <-
+           K$fourier[1] * sin(2 * pi * tau / 52) +
+           K$fourier[2] * cos(2 * pi * tau / 52) +
+           K$fourier[3] * sin(4 * pi * tau / 52) +
+           K$fourier[4] * cos(4 * pi * tau / 52)
+ 
+         # A fixed, interpretable transform is used during generation. It is
+         # passed unchanged to every fitted model.
+         lag_log_y <- if (w == 1L) 0 else (log1p(previous_y) - 1.0) / 1.25
+ 
+         intervention <- treated_s * intensity_s *
+           (
+             K$beta_intensity +
+               K$beta_intensity_time * cos(2 * pi * tau / 52)
+           )
+ 
+         latent_risk_confounding <-
+           0.22 * sc$confounding * latent_access[a] * treated_s
+         differential_ascertainment <-
+           sc$ascertainment_change * treated_s * intensity_s
+ 
+         eta <-
+           log(population_area[a]) +
+           K$alpha +
+           area_re[a] +
+           season_re[s] +
+           epidemic +
+           K$beta_lag * lag_log_y +
+           K$beta_ses * ses_area[a] +
+           area_season_re[a, s] +
+           latent_risk_confounding +
+           intervention +
+           differential_ascertainment
+ 
+         mu <- exp(eta)
+         y <- rnbinom(1L, mu = mu, size = K$phi)
+ 
+         rows[[w]] <- data.table(
+           y = y,
+           population = population_area[a],
+           area = a,
+           season = s,
+           week = w,
+           treated = treated_s,
+           immunisation_intensity = intensity_s,
+           ses = ses_area[a],
+           lag_log_y = lag_log_y,
+           tau_true = tau,
+           shift_true = shift[s],
+           log_speed_true = log_speed[s],
+           beta_true = K$beta_intensity,
+           beta_time_true = K$beta_intensity_time,
+           phi_true = K$phi,
+           sigma_area_season_true = K$sigma_area_season
+         )
+ 
+         previous_y <- y
+       }
+ 
+       out[[pos]] <- rbindlist(rows)
+       pos <- pos + 1L
+     }
+   }
+ 
+   rbindlist(out)
+ }
> 
> extract_wald <- function(fit, coefficient_pattern) {
+   if (inherits(fit, "try-error")) {
+     return(c(estimate = NA_real_, lower = NA_real_, upper = NA_real_, se = NA_real_))
+   }
+ 
+   coefficient_name <- grep(
+     coefficient_pattern,
+     names(stats::coef(fit)),
+     value = TRUE
+   )[1]
+ 
+   if (is.na(coefficient_name)) {
+     return(c(estimate = NA_real_, lower = NA_real_, upper = NA_real_, se = NA_real_))
+   }
+ 
+   estimate <- unname(stats::coef(fit)[coefficient_name])
+   se <- sqrt(stats::vcov(fit)[coefficient_name, coefficient_name])
+ 
+   c(
+     estimate = estimate,
+     lower = estimate - 1.96 * se,
+     upper = estimate + 1.96 * se,
+     se = se
+   )
+ }
> 
> fit_its <- function(dat) {
+   fit <- try(
+     MASS::glm.nb(
+       y ~ offset(log(population)) +
+         splines::ns(week, df = 6) +
+         factor(season) +
+         factor(area) +
+         lag_log_y +
+         ses +
+         treated:immunisation_intensity,
+       data = dat,
+       control = glm.control(maxit = 80)
+     ),
+     silent = TRUE
+   )
+ 
+   extract_wald(fit, "treated:immunisation_intensity")
+ }
> 
> fit_gam <- function(dat) {
+   fit <- try(
+     mgcv::gam(
+       y ~ offset(log(population)) +
+         s(week, k = 12, bs = "cc") +
+         s(area, bs = "re") +
+         s(season, bs = "re") +
+         lag_log_y +
+         ses +
+         treated:immunisation_intensity,
+       family = mgcv::nb(),
+       data = dat,
+       method = "REML",
+       knots = list(week = c(0.5, 52.5))
+     ),
+     silent = TRUE
+   )
+ 
+   extract_wald(fit, "treated:immunisation_intensity")
+ }
> 
> estimate_epidemic_clock <- function(dat) {
+   pre <- dat[treated == 0L]
+ 
+   template <- pre[
+     ,
+     .(incidence = sum(y) / sum(population)),
+     by = week
+   ][order(week)]
+ 
+   shift_grid <- seq(-5, 5, by = 1)
+   speed_grid <- c(0.90, 0.95, 1.00, 1.05, 1.10)
+ 
+   season_clock <- data.table(
+     season = sort(unique(dat$season)),
+     shift_hat = 0,
+     log_speed_hat = 0
+   )
+ 
+   for (ss in season_clock$season) {
+     dd <- dat[
+       season == ss,
+       .(incidence = sum(y) / sum(population)),
+       by = week
+     ][order(week)]
+ 
+     grid <- CJ(shift = shift_grid, speed = speed_grid)
+ 
+     grid[, score := vapply(seq_len(.N), function(i) {
+       tau_candidate <- (dd$week - grid$shift[i]) * grid$speed[i]
+       template_prediction <- approx(
+         x = template$week,
+         y = log1p(template$incidence),
+         xout = tau_candidate,
+         rule = 2
+       )$y
+ 
+       suppressWarnings(
+         cor(
+           log1p(dd$incidence),
+           template_prediction,
+           use = "complete.obs"
+         )
+       )
+     }, numeric(1))]
+ 
+     grid[!is.finite(score), score := -Inf]
+     best <- grid[which.max(score)]
+ 
+     season_clock[
+       season == ss,
+       `:=`(
+         shift_hat = best$shift,
+         log_speed_hat = log(best$speed)
+       )
+     ]
+   }
+ 
+   season_clock
+ }
> 
> fit_aligned_nb <- function(dat) {
+   clock <- estimate_epidemic_clock(dat)
+   dd <- merge(dat, clock, by = "season", all.x = TRUE, sort = FALSE)
+   dd[, tau_hat := (week - shift_hat) * exp(log_speed_hat)]
+ 
+   fit <- try(
+     MASS::glm.nb(
+       y ~ offset(log(population)) +
+         sin(2 * pi * tau_hat / 52) +
+         cos(2 * pi * tau_hat / 52) +
+         sin(4 * pi * tau_hat / 52) +
+         cos(4 * pi * tau_hat / 52) +
+         factor(season) +
+         factor(area) +
+         lag_log_y +
+         ses +
+         treated:immunisation_intensity,
+       data = dd,
+       control = glm.control(maxit = 80)
+     ),
+     silent = TRUE
+   )
+ 
+   extract_wald(fit, "treated:immunisation_intensity")
+ }
> 
> run_fast_rep <- function(i, sc) {
+   scenario_index <- match(sc$scenario, scenarios$scenario)
+   dat <- simulate_one(
+     base_seed + 100000L * scenario_index + i,
+     sc
+   )
+ 
+   estimates <- list(
+     ITS = fit_its(dat),
+     GAM = fit_gam(dat),
+     `Aligned NB` = fit_aligned_nb(dat)
+   )
+ 
+   rbindlist(lapply(names(estimates), function(method_name) {
+     z <- estimates[[method_name]]
+ 
+     data.table(
+       rep = i,
+       scenario = sc$scenario,
+       method = method_name,
+       component = "large_scale_comparison",
+       interval_type = "Wald",
+       true = simulation_constants$beta_intensity,
+       estimate = unname(z["estimate"]),
+       lower = unname(z["lower"]),
+       upper = unname(z["upper"]),
+       se = unname(z["se"]),
+       rhat = NA_real_,
+       ess_bulk = NA_real_,
+       divergences = NA_integer_,
+       max_treedepth_hits = NA_integer_,
+       shift_rmse = NA_real_,
+       speed_rmse = NA_real_,
+       phi_estimate = NA_real_,
+       beta_time_estimate = NA_real_,
+       error = NA_character_
+     )
+   }))
+ }
