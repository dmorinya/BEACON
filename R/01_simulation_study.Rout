> 
> # ---------------------------------------------------------------------------
> # Long-chain robustness subset.
> #
> # The main Bayesian tier uses short chains so that 400 fits stay feasible. This
> # block re-fits the first n_rep_stan_long repetitions of each scenario with a
> # full-length schedule and identical seeds, so the two can be compared directly.
> # ---------------------------------------------------------------------------
> long_output_path <- "results/simulation_beacon_long_raw.csv"
> if (resume_stan && file.exists(long_output_path)) {
+   stan_long <- fread(long_output_path)
+ } else {
+   stan_long <- data.table()
+ }
> 
> if (n_rep_stan_long > 0L) {
+   for (scenario_name in requested_scenarios) {
+     sc <- scenarios[scenario == scenario_name]
+     scenario_index <- match(scenario_name, scenarios$scenario)
+ 
+     for (i in seq_len(min(n_rep_stan_long, n_rep_stan))) {
+       already <- nrow(stan_long) &&
+         any(stan_long$scenario == scenario_name & stan_long$rep == i)
+       if (already) next
+ 
+       message("BEACON-Stan (long): ", scenario_name, ", repetition ", i)
+ 
+       seed_i <- base_seed + 5000000L + 100000L * scenario_index + i
+       dat <- simulate_one(seed_i, sc)
+       z <- fit_beacon_stan(
+         dat, seed_i,
+         warmup = stan_warmup_long,
+         sampling = stan_sampling_long,
+         adapt_delta = stan_adapt_delta_long
+       )
+ 
+       stan_long <- rbindlist(list(stan_long, data.table(
+         rep = i,
+         scenario = scenario_name,
+         method = "BEACON-Stan",
+         component = "bayesian_validation",
+         interval_type = "credible",
+         true = simulation_constants$beta_intensity,
+         estimate = z$estimate,
+         lower = z$lower,
+         upper = z$upper,
+         se = z$se,
+         rhat = z$rhat,
+         ess_bulk = z$ess_bulk,
+         divergences = z$divergences,
+         max_treedepth_hits = z$max_treedepth_hits,
+         shift_rmse = z$shift_rmse,
+         speed_rmse = z$speed_rmse,
+         phi_estimate = z$phi_estimate,
+         beta_time_estimate = z$beta_time_estimate,
+         modulation_amplitude = z$modulation_amplitude,
+         sigma_series_estimate = z$sigma_series_estimate,
+         schedule = "long",
+         error = z$error
+       )), fill = TRUE, use.names = TRUE)
+       setorder(stan_long, scenario, rep)
+       fwrite(stan_long, long_output_path)
+     }
+   }
+ 
+   if (nrow(stan_long)) {
+     matched <- merge(
+       stan_raw[, .(scenario, rep, estimate_short = estimate,
+                    width_short = upper - lower)],
+       stan_long[, .(scenario, rep, estimate_long = estimate,
+                     width_long = upper - lower)],
+       by = c("scenario", "rep")
+     )
+     schedule_check <- matched[
+       is.finite(estimate_short) & is.finite(estimate_long),
+       .(
+         n_pairs = .N,
+         mean_abs_difference = mean(abs(estimate_short - estimate_long)),
+         max_abs_difference = max(abs(estimate_short - estimate_long)),
+         mean_width_short = mean(width_short),
+         mean_width_long = mean(width_long)
+       ),
+       by = scenario
+     ]
+     fwrite(schedule_check, "results/simulation_schedule_check.csv")
+   }
+ }
