> # The v2 data list carries an area-season index, a week pivot and the
> # contiguous series blocks required by the dynamic g-formula, so it is built by
> # the shared helper rather than assembled here. Note that the helper rebuilds
> # the lagged covariate from y using its own centring and scaling constants,
> # which Stan then reuses inside the recursion; the lag_log_y column produced by
> # simulate_one() is retained only for the three comparator models, which take
> # the generator's fixed transform.
> make_stan_data <- function(dat) {
+   dat <- copy(dat)
+   dat[, area_id := match(area, sort(unique(area)))]
+   dat[, season_id := match(season, sort(unique(season)))]
+   dat[, week_in_season := as.integer(week)]
+ 
+   build_beacon_stan_data(
+     dat,
+     H = stan_H,
+     harmonic_decay = stan_harmonic_decay,
+     prior_mean_beta_intensity = stan_prior_mean_beta,
+     prior_sd_beta_intensity = stan_prior_sd_beta,
+     prior_sd_ascertainment = 0,
+     compute_log_lik = 0L,
+     compute_y_rep = 0L,
+     # The simulation targets beta_intensity, and the recursive contrast costs
+     # an rng pass over every observation on every draw. Enable it only if the
+     # dynamic estimand is itself being studied.
+     dynamic_gformula = 0L
+   )$stan_data
+ }
> 
> # Dispersed inits on the v2 parameter names. The v1 version initialised the
> # Fourier coefficients, beta_lag, beta_ses, beta_intensity and phi at their
> # data-generating values, which makes a calibration study circular.
> make_inits <- function(stan_data, chains, seed) {
+   make_beacon_inits_v2(stan_data, chains, seed)
+ }
> 
> safe_diagnostic_value <- function(diagnostics, candidate_names) {
+   candidate <- intersect(candidate_names, names(diagnostics))[1]
+   if (is.na(candidate)) return(NA_real_)
+   sum(diagnostics[[candidate]], na.rm = TRUE)
+ }
> 
> fit_beacon_stan <- function(dat, seed,
+                             warmup = stan_warmup,
+                             sampling = stan_sampling,
+                             adapt_delta = stan_adapt_delta) {
+   stan_data <- make_stan_data(dat)
+   init_list <- make_inits(stan_data, stan_chains, seed + 900000L)
+ 
+   fit <- try(
+     beacon_model$sample(
+       data = stan_data,
+       seed = seed,
+       chains = stan_chains,
+       parallel_chains = stan_parallel_chains,
+       init = init_list,
+       iter_warmup = warmup,
+       iter_sampling = sampling,
+       adapt_delta = adapt_delta,
+       max_treedepth = stan_max_treedepth,
+       refresh = stan_refresh,
+       save_warmup = FALSE,
+       show_messages = FALSE,
+       output_dir = tempdir()
+     ),
+     silent = TRUE
+   )
+ 
+   if (inherits(fit, "try-error")) {
+     return(data.table(
+       estimate = NA_real_,
+       lower = NA_real_,
+       upper = NA_real_,
+       se = NA_real_,
+       rhat = NA_real_,
+       ess_bulk = NA_real_,
+       divergences = NA_integer_,
+       max_treedepth_hits = NA_integer_,
+       shift_rmse = NA_real_,
+       speed_rmse = NA_real_,
+       phi_estimate = NA_real_,
+       beta_time_estimate = NA_real_,
+       modulation_amplitude = NA_real_,
+       sigma_series_estimate = NA_real_,
+       error = as.character(fit)
+     ))
+   }
+ 
+   output_files <- try(fit$output_files(), silent = TRUE)
+   if (!inherits(output_files, "try-error")) {
+     on.exit(unlink(output_files, force = TRUE), add = TRUE)
+   }
+ 
+   # v2 replaces the single cosine modulation coefficient by a free-phase pair,
+   # and adds the area-season scale.
+   variables <- c(
+     "beta_intensity",
+     "beta_intensity_cos",
+     "beta_intensity_sin",
+     "sigma_series",
+     "phi",
+     "shift",
+     "log_speed"
+   )
+ 
+   draws <- posterior::as_draws_df(
+     fit$draws(variables = variables)
+   )
+ 
+   beta_draws <- draws[["beta_intensity"]]
+   # Report the modulation amplitude, which is invariant to the phase, rather
+   # than either coefficient on its own.
+   modulation_draws <- sqrt(
+     draws[["beta_intensity_cos"]]^2 + draws[["beta_intensity_sin"]]^2
+   )
+   beta_time_draws <- draws[["beta_intensity_cos"]]
+   sigma_series_draws <- draws[["sigma_series"]]
+   phi_draws <- draws[["phi"]]
+ 
+   fit_summary <- fit$summary(
+     variables = c("beta_intensity", "beta_intensity_cos", "phi")
+   )
+   beta_summary <- fit_summary[
+     fit_summary$variable == "beta_intensity",
+     ,
+     drop = FALSE
+   ]
+ 
+   shift_names <- grep("^shift\\[", names(draws), value = TRUE)
+   speed_names <- grep("^log_speed\\[", names(draws), value = TRUE)
+ 
+   shift_estimate <- colMeans(as.matrix(draws[, shift_names, drop = FALSE]))
+   speed_estimate <- colMeans(as.matrix(draws[, speed_names, drop = FALSE]))
+ 
+   shift_true <- dat[
+     ,
+     shift_true[1],
+     by = season
+   ][order(season)]$V1
+   speed_true <- dat[
+     ,
+     log_speed_true[1],
+     by = season
+   ][order(season)]$V1
+ 
+   diagnostics <- try(fit$diagnostic_summary(), silent = TRUE)
+   if (inherits(diagnostics, "try-error")) {
+     divergences <- NA_integer_
+     max_depth <- NA_integer_
+   } else {
+     divergences <- as.integer(
+       safe_diagnostic_value(
+         diagnostics,
+         c("num_divergent", "num_divergences", "divergent__")
+       )
+     )
+     max_depth <- as.integer(
+       safe_diagnostic_value(
+         diagnostics,
+         c("num_max_treedepth", "num_max_treedepth_hits")
+       )
+     )
+   }
+ 
+   data.table(
+     estimate = mean(beta_draws),
+     lower = unname(quantile(beta_draws, 0.025)),
+     upper = unname(quantile(beta_draws, 0.975)),
+     se = sd(beta_draws),
+     rhat = if (nrow(beta_summary)) beta_summary$rhat[1] else NA_real_,
+     ess_bulk = if (nrow(beta_summary)) beta_summary$ess_bulk[1] else NA_real_,
+     divergences = divergences,
+     max_treedepth_hits = max_depth,
+     shift_rmse = sqrt(mean((shift_estimate - shift_true)^2)),
+     speed_rmse = sqrt(mean((speed_estimate - speed_true)^2)),
+     phi_estimate = mean(phi_draws),
+     beta_time_estimate = mean(beta_time_draws),
+     modulation_amplitude = mean(modulation_draws),
+     sigma_series_estimate = mean(sigma_series_draws),
+     error = NA_character_
+   )
+ }
> 
> stan_output_path <- "results/simulation_beacon_raw.csv"
> if (resume_stan && file.exists(stan_output_path)) {
+   stan_raw <- fread(stan_output_path)
+ } else {
+   stan_raw <- data.table()
+ }
> 
> completed_key <- function(scenario_name, repetition) {
+   if (!nrow(stan_raw)) return(FALSE)
+   any(
+     stan_raw$scenario == scenario_name &
+       stan_raw$rep == repetition
+   )
+ }
> 
> message(
+   "Running BEACON-Stan validation: ",
+   n_rep_stan,
+   " repetitions x ",
+   length(requested_scenarios),
+   " scenarios; ",
+   stan_chains,
+   " chains, ",
+   stan_warmup,
+   " warm-up + ",
+   stan_sampling,
+   " sampling iterations."
+ )
Running BEACON-Stan validation: 100 repetitions x 4 scenarios; 4 chains, 300 warm-up + 300 sampling iterations.
> 
> for (scenario_name in requested_scenarios) {
+   sc <- scenarios[scenario == scenario_name]
+   scenario_index <- match(scenario_name, scenarios$scenario)
+ 
+   for (i in seq_len(n_rep_stan)) {
+     if (completed_key(scenario_name, i)) next
+ 
+     if (i == 1L || i %% 5L == 0L) {
+       message(
+         "BEACON-Stan: scenario ",
+         scenario_name,
+         ", repetition ",
+         i,
+         "/",
+         n_rep_stan
+       )
+     }
+ 
+     seed_i <- base_seed + 5000000L + 100000L * scenario_index + i
+     dat <- simulate_one(seed_i, sc)
+     z <- fit_beacon_stan(dat, seed_i)
+ 
+     row <- data.table(
+       rep = i,
+       scenario = scenario_name,
+       method = "BEACON-Stan",
+       component = "bayesian_validation",
+       interval_type = "credible",
+       true = simulation_constants$beta_intensity,
+       estimate = z$estimate,
+       lower = z$lower,
+       upper = z$upper,
+       se = z$se,
+       rhat = z$rhat,
+       ess_bulk = z$ess_bulk,
+       divergences = z$divergences,
+       max_treedepth_hits = z$max_treedepth_hits,
+       shift_rmse = z$shift_rmse,
+       speed_rmse = z$speed_rmse,
+       phi_estimate = z$phi_estimate,
+       beta_time_estimate = z$beta_time_estimate,
+       modulation_amplitude = z$modulation_amplitude,
+       sigma_series_estimate = z$sigma_series_estimate,
+       schedule = "short",
+       error = z$error
+     )
+ 
+     stan_raw <- rbindlist(
+       list(stan_raw, row),
+       fill = TRUE,
+       use.names = TRUE
+     )
+     setorder(stan_raw, scenario, rep)
+     fwrite(stan_raw, stan_output_path)
+   }
+ }
