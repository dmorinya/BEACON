> performance <- raw[
+   is.finite(estimate) & is.finite(lower) & is.finite(upper),
+   {
+     errors <- estimate - true
+     empirical_coverage <- mean(covered)
+ 
+     list(
+       n_success = .N,
+       bias = mean(errors),
+       bias_mcse = if (.N > 1L) sd(errors) / sqrt(.N) else NA_real_,
+       rmse = sqrt(mean(errors^2)),
+       coverage = empirical_coverage,
+       coverage_mcse = sqrt(
+         empirical_coverage * (1 - empirical_coverage) / .N
+       ),
+       mean_interval_width = mean(interval_width),
+       mean_estimate = mean(estimate),
+       true_log_rr = mean(true),
+       mean_rhat = if (all(is.na(rhat))) NA_real_ else mean(rhat, na.rm = TRUE),
+       max_rhat = if (all(is.na(rhat))) NA_real_ else max(rhat, na.rm = TRUE),
+       median_ess_bulk = if (all(is.na(ess_bulk))) NA_real_ else median(ess_bulk, na.rm = TRUE),
+       total_divergences = if (all(is.na(divergences))) NA_integer_ else sum(divergences, na.rm = TRUE),
+       total_max_treedepth_hits = if (all(is.na(max_treedepth_hits))) NA_integer_ else sum(max_treedepth_hits, na.rm = TRUE)
+     )
+   },
+   by = .(scenario, method, component, interval_type)
